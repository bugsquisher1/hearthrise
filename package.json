{
  "name": "hearthrise",
  "version": "0.9.2-beta",
  "private": true,
  "description": "Hearthrise — cozy idle homestead RPG. Static site, no build step; this manifest exists only so CI can install Playwright and run the in-game smoke suite headlessly.",
  "type": "module",
  "scripts": {
    "test": "node tests/run-smoke.mjs",
    "test:headed": "node tests/run-smoke.mjs --headed",
    "check:version": "bash bump-version.sh --check",
    "test:sql": "node tests/run-sql-tests.mjs",
    "test:activity-intent": "node tests/activity-intent.mjs",
    "test:claim-intent": "node tests/claim-intent.mjs --selftest",
    "test:market-offers": "node tests/market-offers-guard.mjs",
    "test:market-lockdown": "node tests/market-offers-lockdown.mjs",
    "test:market-v2": "node tests/market-v2.mjs --selftest",
    "test:market-intent": "node tests/market-intent.mjs --selftest",
    "test:lb-lockdown": "node tests/leaderboard-lockdown-guard.mjs",
    "test:raid-band": "node tests/raid-band-denial.mjs --selftest",
    "test:raid-card": "node tests/raid-card-copy.mjs",
    "test:clan-journal": "node tests/clan-journal-guard.mjs --selftest",
    "test:anon-rate": "node tests/anon-rate-gate.mjs --selftest",
    "test:activity-intent:selftest": "node tests/activity-intent.mjs --selftest",
    "test:gold-intents": "node tests/gold-intents.mjs",
    "test:gold-intents:selftest": "node tests/gold-intents.mjs --selftest",
    "test:delta-transport": "node tests/delta-transport.mjs",
    "test:delta-transport:selftest": "node tests/delta-transport.mjs --selftest",
    "test:schema-drift": "node tests/schema-drift.mjs",
    "test:schema-drift:selftest": "node tests/schema-drift.mjs --mutate",
    "test:schema-drift:live-selftest": "node tests/schema-drift.mjs --live-selftest",
    "schema-drift:live-sql": "node tests/schema-drift.mjs --live-sql",
    "test:schema-replay": "node tests/schema-replay.mjs --list",
    "test:gem-budget": "node tests/gem-daily-budget.mjs",
    "test:gem-budget:selftest": "node tests/gem-daily-budget.mjs --mutate",
    "test:conservation": "node tests/conservation-fuzz.mjs --ops=400",
    "test:conservation:selftest": "node tests/conservation-fuzz.mjs --selftest --ops=400",
    "test:conservation:soak": "node tests/conservation-fuzz.mjs --ops=5000 --users=6 --slots=2",
    "test:open-beta": "node tests/open-beta.mjs",
    "test:open-beta:selftest": "node tests/open-beta.mjs --selftest",
    "test:bug-triage": "node tests/bug-triage.mjs",
    "test:bug-triage:mutate": "node tests/bug-triage.mjs --mutate",
    "test:intent-mismatch": "node tests/intent-mismatch.mjs",
    "test:intent-mismatch:selftest": "node tests/intent-mismatch.mjs --selftest",
    "test:cron-health": "node tests/cron-health.mjs",
    "test:cron-health:selftest": "node tests/cron-health.mjs --selftest",
    "test:restore-census": "node tests/restore-census.mjs",
    "test:restore-census:mutate": "node tests/restore-census.mjs --mutate",
    "test:restore-census:selftest": "node tests/restore-census.mjs --baseline-selftest",
    "restore-census:live-sql": "node tests/restore-census.mjs --live-sql"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.8",
    "playwright": "^1.47.0",
    "postgres": "3.4.5"
  }
}
